# 로컬 개발: SQLite 사용 (기본값 그대로 두면 됨)
# 운영: Postgres 사용
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_guideline_compass

SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CHROMA_PERSIST_DIR=/app/vector_store_data
EMBEDDING_PROVIDER=tfidf

# 설정 시 챗봇이 근거 조항을 바탕으로 자연어 답변을 생성합니다 (없으면 조항 인용형으로 대체)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ORIGINS=["http://localhost:5173"]

# 관리자 계정 가입 시 요구되는 코드. 운영 환경에서는 반드시 무작위 값으로 변경하세요.
ADMIN_INVITE_CODE=CHANGE_ME_ADMIN_CODE
